{
  "manifest_version": 3,
  "name": "LinkedIn Job Analyzer",
  "version": "1.0.0",
  "description": "Analyze LinkedIn job descriptions using AI.",

  "permissions": ["activeTab"],

  "host_permissions": ["https://www.linkedin.com/*", "http://localhost:8000/*"],

  "action": {
    "default_title": "LinkedIn Job Analyzer"
  },

  "background": {
    "service_worker": "dist/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["dist/content.js"]
    }
  ]
}
